# Agent 72 Frontend Environment Configuration
# In local development, leave empty to use Vite proxy (/api/v1 -> localhost:8000), or set directly:
# VITE_API_URL=http://localhost:8000

# In production (e.g. Vercel dashboard environment variables), set to your live Render backend URL:
# VITE_API_URL=https://<your-render-app>.onrender.com
