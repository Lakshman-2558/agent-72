# ==============================================================================
# Agent 72: Strategic Planning Agent - Environment Configuration Template
# ==============================================================================

# Application Environment: 'development', 'testing', or 'production'
ENVIRONMENT=development

# Server Host and Port
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Structured Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# Relational Database Configuration
# ==============================================================================
# Option 1: SQLite for local development & testing (Default)
DATABASE_URL=sqlite:///./agent72.db

# Option 2: Neon PostgreSQL for deployment / production
# Format: postgresql+psycopg://<username>:<password>@<ep-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# Note: Standard postgresql:// or postgres:// will be automatically normalized to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ==============================================================================
# AI Provider Abstraction Configuration
# ==============================================================================
# Supported providers: 'mock', 'openai', 'gemini', 'anthropic'
# For Phase 1, 'mock' is used.
AI_PROVIDER_TYPE=mock
AI_MODEL_NAME=mock-strategic-v1
# AI_API_KEY=your-api-key-here

# ==============================================================================
# Security & CORS
# ==============================================================================
# Comma-separated or JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://agent-72-zeta.vercel.app","https://agent-72.vercel.app"]
CORS_ORIGIN_REGEX=^(https?://(localhost|127\.0\.0\.1)(:\d+)?|https://.*\.vercel\.app|https://.*\.onrender\.com)$
